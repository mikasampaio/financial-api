# MongoDB com replica set (necessário para transações atômicas do Prisma 6).
DATABASE_URL="mongodb://localhost:27017/financial?replicaSet=rs0"
JWT_SECRET_KEY="replace-with-a-long-random-secret"
PORT=3000

# Recuperação de senha: configure um SMTP real ou local (ex.: Mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Controle financeiro <no-reply@example.com>"
# Tela do front-end que recebe ?token=... e chama POST /auth/reset-password.
PASSWORD_RESET_URL="http://localhost:5173/reset-password"

# Executa ao iniciar a API e a cada minuto. Desative somente em instâncias sem worker.
RECURRENCE_WORKER_ENABLED=true
